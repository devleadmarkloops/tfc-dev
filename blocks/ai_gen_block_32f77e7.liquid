{% doc %}
  @prompt
    a product grid where i can add static images among the products to tell the story of the brand, when i choose "Image with text overlay " on story item and add an image, the image doesn't take the whole block an dthe bottom behind the text is white. fix that and make the image i upload take the whole block, i would like to choose wether the text is aligned to center, left or right

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-story-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-story-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-story-grid__item-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-story-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-story-grid__product-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .ai-story-grid__image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-story-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-story-grid__product-{{ ai_gen_id }}:hover .ai-story-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-story-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-story-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-story-grid__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-story-grid__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-story-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-story-grid__title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    line-height: 1.3;
  }

  .ai-story-grid__price-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 500;
  }

  .ai-story-grid__story-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-story-grid__story-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    text-align: {{ block.settings.story_text_alignment }};
    background-color: {{ block.settings.story_background }};
  }

  .ai-story-grid__story-title-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-size: {{ block.settings.story_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.story_text_color }};
    line-height: 1.3;
  }

  .ai-story-grid__story-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.story_text_size }}px;
    color: {{ block.settings.story_text_color }};
    line-height: 1.5;
  }

  .ai-story-grid__story-image-only-{{ ai_gen_id }} {
    position: relative;
    height: 100%;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-story-grid__story-full-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .ai-story-grid__story-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-story-grid__story-overlay-content-{{ ai_gen_id }} {
    color: white;
    text-align: {{ block.settings.story_overlay_text_alignment }};
    width: 100%;
  }

  .ai-story-grid__story-overlay-title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.story_title_size }}px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-story-grid__story-overlay-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.story_text_size }}px;
    line-height: 1.5;
  }

  .ai-story-grid__story-placeholder-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;}

  .ai-story-grid__story-placeholder-overlay-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<story-product-grid-{{ ai_gen_id }}
  class="ai-story-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.collection != blank %}
    {% assign products = block.settings.collection.products %}
    {% assign total_items = block.settings.products_to_show %}
    {% assign story_positions = block.settings.story_positions | split: ',' %}
    {% assign current_product_index = 0 %}
    {% assign current_story_index = 1 %}

    {% for i in (1..total_items) %}
      {% assign is_story_position = false %}
      {% for position in story_positions %}
        {% assign position_num = position | strip | plus: 0 %}
        {% if position_num == i %}
          {% assign is_story_position = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if is_story_position %}
        {% liquid
          assign story_image_key = 'story_image_' | append: current_story_index
          assign story_title_key = 'story_title_' | append: current_story_index
          assign story_text_key = 'story_text_' | append: current_story_index
          assign story_layout_key = 'story_layout_' | append: current_story_index

          assign story_image = block.settings[story_image_key]
          assign story_title = block.settings[story_title_key]
          assign story_text = block.settings[story_text_key]
          assign story_layout = block.settings[story_layout_key]
        %}

        <div class="ai-story-grid__item-{{ ai_gen_id }}">
          <div class="ai-story-grid__story-item-{{ ai_gen_id }}">
            {% if story_layout == 'image_only' %}
              <div class="ai-story-grid__story-image-only-{{ ai_gen_id }}">
                {% if story_image %}
                  <img
                    src="{{ story_image | image_url: width: 800 }}"
                    alt="{{ story_image.alt | escape }}"
                    class="ai-story-grid__story-full-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ story_image.width }}"
                    height="{{ story_image.height }}"
                  >
                {% else %}
                  <div class="ai-story-grid__story-placeholder-overlay-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                
                {% if story_title != blank or story_text != blank %}
                  <div class="ai-story-grid__story-overlay-{{ ai_gen_id }}">
                    <div class="ai-story-grid__story-overlay-content-{{ ai_gen_id }}">
                      {% if story_title != blank %}
                        <h3 class="ai-story-grid__story-overlay-title-{{ ai_gen_id }}">{{ story_title }}</h3>
                      {% endif %}
                      {% if story_text != blank %}
                        <p class="ai-story-grid__story-overlay-text-{{ ai_gen_id }}">{{ story_text }}</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}

                {% if story_image == blank %}
                  <div class="ai-story-grid__story-overlay-{{ ai_gen_id }}">
                    <div class="ai-story-grid__story-overlay-content-{{ ai_gen_id }}">
                      <div style="color: white; font-style: italic; font-size: 14px; text-align: center;">
                        Add story image {{ current_story_index }}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            {% else %}
              {% if story_image %}
                <div class="ai-story-grid__image-container-{{ ai_gen_id }}">
                  <img
                    src="{{ story_image | image_url: width: 800 }}"
                    alt="{{ story_image.alt | escape }}"
                    class="ai-story-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ story_image.width }}"
                    height="{{ story_image.height }}"
                  >
                </div>
              {% endif %}
              <div class="ai-story-grid__story-content-{{ ai_gen_id }}">
                {% if story_title != blank %}
                  <h3 class="ai-story-grid__story-title-{{ ai_gen_id }}">{{ story_title }}</h3>
                {% endif %}
                {% if story_text != blank %}
                  <p class="ai-story-grid__story-text-{{ ai_gen_id }}">{{ story_text }}</p>
                {% endif %}
                {% if story_title == blank and story_text == blank %}
                  <div style="color: #666; font-style: italic; font-size: 14px;">
                    Add story content {{ current_story_index }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
        {% assign current_story_index = current_story_index | plus: 1 %}
      {% else %}
        {% if products[current_product_index] %}
          {% assign product = products[current_product_index] %}
          <div class="ai-story-grid__item-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-story-grid__product-{{ ai_gen_id }}">
              <div class="ai-story-grid__image-container-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-story-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {% else %}
                  <div class="ai-story-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                {% unless product.available %}
                  <div class="ai-story-grid__badge-{{ ai_gen_id }}">
                    Sold out
                  </div>
                {% endunless %}
              </div>
              
              <div class="ai-story-grid__content-{{ ai_gen_id }}">
                <h3 class="ai-story-grid__title-{{ ai_gen_id }}">{{ product.title }}</h3>
                <p class="ai-story-grid__price-{{ ai_gen_id }}">{{ product.price | money }}</p>
              </div>
            </a>
          </div>
          {% assign current_product_index = current_product_index | plus: 1 %}
        {% else %}
          <div class="ai-story-grid__item-{{ ai_gen_id }}">
            <div class="ai-story-grid__image-container-{{ ai_gen_id }}">
              <div class="ai-story-grid__placeholder-{{ ai_gen_id }}">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
                <div class="ai-story-grid__empty-state-{{ ai_gen_id }}">
                  Add more products to collection
                </div>
              </div>
            </div>
            <div class="ai-story-grid__content-{{ ai_gen_id }}">
              <h3 class="ai-story-grid__title-{{ ai_gen_id }}">Product title</h3>
              <p class="ai-story-grid__price-{{ ai_gen_id }}">$0.00</p>
            </div>
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% else %}
    {% for i in (1..6) %}
      <div class="ai-story-grid__item-{{ ai_gen_id }}">
        <div class="ai-story-grid__image-container-{{ ai_gen_id }}">
          <div class="ai-story-grid__placeholder-{{ ai_gen_id }}">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% if forloop.first %}
              <div class="ai-story-grid__empty-state-{{ ai_gen_id }}">
                Select a collection to display products
              </div>
            {% endif %}
          </div>
        </div>
        <div class="ai-story-grid__content-{{ ai_gen_id }}">
          <h3 class="ai-story-grid__title-{{ ai_gen_id }}">Product title</h3>
          <p class="ai-story-grid__price-{{ ai_gen_id }}">$0.00</p>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</story-product-grid-{{ ai_gen_id }}>

<script>
(function() {
  class StoryProductGrid{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.setupGrid();
    }

    setupGrid() {
      const items = this.querySelectorAll('.ai-story-grid__item-{{ ai_gen_id }}');
      items.forEach((item, index) => {
        item.style.animationDelay = `${index * 0.1}s`;
      });
    }
  }

  customElements.define('story-product-grid-{{ ai_gen_id }}', StoryProductGrid{{ ai_gen_id }});
})();
</script>

