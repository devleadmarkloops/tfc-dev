stom_section_colors_background":"#ffffff","custom_section_gradient_background":"","desktop_content_alignment":"left","desktop_content_position":"middle","desktop_image_width":"medium","display_id":false,"height":"adapt","image":"shopify://shop_images/fleece_guarantee_af31372d-d782-47ba-a4d5-8bc1ccdbf762.png","layout":"text_first","mobile_content_alignment":"left","mobile_direction":"normal","mobile_full_media_width":false,"mobile_image_quanlity":"2","padding_bottom":36,"padding_top":36,"section_color_scheme":"background-1","visibility":"always-display"},"type":"image-with-text"},"newsletter_BfbTVm":{"block_order":["heading_G8TGPN","paragraph_EgJDff","email_form_4pypHw"],"blocks":{"email_form_4pypHw":{"settings":{},"type":"email_form"},"heading_G8TGPN":{"settings":{"heading_size":"h1","title":"Subscribe to our emails","title_highlight_color":"#6d388b"},"type":"heading"},"paragraph_EgJDff":{"settings":{"text":"\u003cp\u003eBe the first to know about new collections and exclusive offers.\u003c/p\u003e"},"type":"paragraph"}},"settings":{"button_label":"Sign up","button_style_secondary":false,"button_type":"solid","color_scheme":"background-1","custom_colors_background":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_text":"#2e2a39","custom_gradient_background":"","display_id":false,"full_width":true,"padding_bottom":52,"padding_top":40,"visibility":"always-display"},"type":"newsletter"},"testimonials_6xHFGj":{"block_order":["column_UfFjkt","column_NKGdwP","column_9FHQtH","column_nffryz","column_NBnkKz","column_ydrW9L","column_QDHcDi","column_zp6mpN","column_KzKjH6","column_rDmjC7","column_cp8f63","column_CxXqNp","column_cbryTQ","column_cB4nXP","column_W96GcV"],"blocks":{"column_9FHQtH":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eSarah\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eThe pajamas from The Fleece Company are SO soft I can hardly believe it! I bought a pair the next day for my sister,too!\u003c/p\u003e","title":"Perfect!"},"type":"column"},"column_CxXqNp":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eLea\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eLove this king size blanket! It’s very light, not heavy like most. Yet it keeps you warm and comfy!\u003c/p\u003e","title":"Warm Yet Not Heavy"},"type":"column"},"column_KzKjH6":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eLaura\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eThe products are excellent. I have one of the muslin blankets which is so soft and am currently waiting for one of the fleece blankets\u003c/p\u003e","title":"Muslin \u0026 Fleece Love"},"type":"column"},"column_NBnkKz":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eTessa\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eI have hot flashes when I wake up during the night. The fleece blanket is really soft and not too hot or cold. I’m very much enjoying it and my husband has his own. I just purchased 2 warmer ones for winter!\u003c/p\u003e","title":"No More Night Sweats"},"type":"column"},"column_NKGdwP":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eEkin\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eIt takes forever to get the blankets but I absolutely love mine that I received. Bought 2 XL kings for my bed and 1 full just for me.\u003c/p\u003e","title":"Unmatched comfort!"},"type":"column"},"column_QDHcDi":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eClara\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eJust the perfect blanket for Spring, Summer \u0026 Fall. light weight yet warms you up plus just Cole and l leave mine hanging on back of chair in same room when not using for an accent in the room .\u003c/p\u003e","title":"Great For All Seasons"},"type":"column"},"column_UfFjkt":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eJess\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eI am thrilled to find such excellent quality in the blankets\u003c/p\u003e","title":"Best blanket ever!"},"type":"column"},"column_W96GcV":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eLizzy\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eOrdering is easy. Notification of shipment is quick. The product is great - the first is great so ordered another!\u003c/p\u003e","title":"Quality #1"},"type":"column"},"column_cB4nXP":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eAmelie\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eThe fleece blanket actually exceeded my expections, not just in the look of the product, but also the feel. Soft, inviting, calming colour (I had the green). I have now ordered a blue one for my daughter, to stop her stealing mine!\u003c/p\u003e","title":"Exceeded Expectations"},"type":"column"},"column_cbryTQ":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eIsabella\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eExcellent products and service. Well packaged and items are well made! Support service is outstanding and willing to resolve issues in a timely manner. Highly recommend this company and their clothing. Communication regarding delivery is excellent! Will buy from again and again.\u003c/p\u003e","title":"Quick \u0026 Easy Order"},"type":"column"},"column_cp8f63":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eNora\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eGreat blankets. Very soft and cozy though being really lightweight. Made from natural fabric. Lovely colours. Looking forward to trying them over the winter.\u003c/p\u003e","title":"Lightweight and Cozy"},"type":"column"},"column_nffryz":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eMia\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eThe pyjamas I ordered are beautiful and soft. I have ordered a second set because now I’ve tried these I don’t want to wear anything else.\u003c/p\u003e","title":"Beautiful!"},"type":"column"},"column_rDmjC7":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eMarie\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eThe ordering process was easy shipping was very quick and the blanket is amazing\u003c/p\u003e","title":"Fast Shipping, Great Blanket"},"type":"column"},"column_ydrW9L":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eOlivia\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eTruly can’t get enough, so comfortable , washes beautifully and will definitely buy more. Thanks for the cuddly comfort\u003c/p\u003e","title":"So Comfortable"},"type":"column"},"column_zp6mpN":{"settings":{"author":"\u003cem\u003e\u003cstrong\u003eAnna\u003c/strong\u003e\u003c/em\u003e","text":"\u003cp\u003eProducts are top notch and I found it easy to negotiate their web site. After ordering my first pair, I received a discount code for next order. Pretty common but the pajamas I received were so soft I ordered a second pair.\u003c/p\u003e","title":"Top-Notch Products"},"type":"column"}},"settings":{"arrows_color_scheme":"inverse","autoplay":false,"autoplay_speed":5,"cards_color_scheme":"bg-overlay","color_scheme":"background-1","column_alignment":"center","columns_desktop":4,"custom_cards_colors_background":"#f3f3f3","custom_cards_colors_text":"#2e2a39","custom_cards_gradient_background":"","custom_colors_background":"#ffffff","custom_colors_text":"#2e2a39","custom_gradient_background":"","desktop_adaptive_height":true,"desktop_arrows_position":"sides","desktop_dots_position":"under","desktop_full_page":false,"desktop_padding_calc":true,"desktop_side_padding":0,"desktop_spacing":40,"display_id":false,"dots_color_scheme":"inverse","enable_mobile_preview":false,"heading_size":"h1","image_ratio":"square","image_width":"full","mobile_adaptive_height":true,"mobile_arrows_position":"under","mobile_dots_position":"under","padding_bottom":36,"padding_top":0,"per_move_desktop":1,"quotes_color_scheme":"accent-2","show_quotes":true,"show_stars":true,"slider_desktop":true,"slider_