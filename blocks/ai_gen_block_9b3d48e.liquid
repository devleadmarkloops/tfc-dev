{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-header-{{ ai_gen_id }}">
    <div class="ai-product-grid-dropdown-{{ ai_gen_id }}">
      <select class="ai-product-grid-select-{{ ai_gen_id }}" aria-label="Sort products">
        <option value="featured">Sort: Featured</option>
        <option value="price-low-high">Price: Low to High</option>
        <option value="price-high-low">Price: High to Low</option>
        <option value="newest">Newest</option>
        <option value="best-selling">Best Selling</option>
      </select>
    </div>
  </div>

  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% assign story_cards_added = 0 %}
    {% assign products_added = 0 %}
    {% assign total_positions = block.settings.products_to_show %}

    {% for position in (1..total_positions) %}
      {% assign story_card_added = false %}

      {% for i in (1..3) %}
        {% assign story_mobile_position_key = 'story_card_' | append: i | append: '_mobile_position' %}
        {% assign story_desktop_position_key = 'story_card_' | append: i | append: '_desktop_position' %}
        {% assign story_enabled_key = 'story_card_' | append: i | append: '_enabled' %}
        {% assign story_image_key = 'story_card_' | append: i | append: '_image' %}
        {% assign story_title_key = 'story_card_' | append: i | append: '_title' %}
        {% assign story_text_key = 'story_card_' | append: i | append: '_text' %}

        {% assign mobile_position = block.settings[story_mobile_position_key] %}
        {% assign desktop_position = block.settings[story_desktop_position_key] %}

        {% if block.settings[story_enabled_key] and mobile_position == position %}
          <div class="ai-story-card-{{ ai_gen_id }} ai-story-card-mobile-position-{{ mobile_position }}-{{ ai_gen_id }} ai-story-card-desktop-position-{{ desktop_position }}-{{ ai_gen_id }}">
            <div class="ai-story-card-image-container-{{ ai_gen_id }}">
              {% if block.settings[story_image_key] %}
                <img
                  src="{{ block.settings[story_image_key] | image_url: width: 400 }}"
                  alt="{{ block.settings[story_image_key].alt | escape }}"
                  class="ai-story-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-story-card-image-placeholder-{{ ai_gen_id }}">
                  {{'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <div class="ai-story-card-overlay-{{ ai_gen_id }}">
                <div class="ai-story-card-content-{{ ai_gen_id }}">
                  {% if block.settings[story_title_key] != blank %}
                    <h3 class="ai-story-card-title-{{ ai_gen_id }}">{{ block.settings[story_title_key] }}</h3>
                  {% endif %}
                  {% if block.settings[story_text_key] != blank %}
                    <p class="ai-story-card-text-{{ ai_gen_id }}">{{ block.settings[story_text_key] }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          {% assign story_card_added = true %}
          {% assign story_cards_added = story_cards_added | plus: 1 %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% unless story_card_added %}
        {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
          {% assign product_index = products_added | plus: 1 %}
          {% assign product = block.settings.collection.products[products_added] %}
          {% if product %}
            <div class="ai-product-card-{{ ai_gen_id }}">
              <div class="ai-product-image-container-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product_index <= 2 %}
                  <div class="ai-best-seller-badge-{{ ai_gen_id }}">
                    Best Seller
                  </div>
                {% endif %}
              </div>

              <div class="ai-product-info-{{ ai_gen_id }}">
                <h3 class="ai-product-title-{{ ai_gen_id }}"><a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="ai-product-price-container-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-price-original-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span class="ai-product-price-sale-{{ ai_gen_id }}">
                    From {{ product.price | money }}
                  </span>
                </div>

                {% if product.options contains 'Color' %}
                  <div class="ai-color-swatches-{{ ai_gen_id }}">
                    {% assign color_option = product.options_by_name['Color'] %}
                    {% if color_option %}
                      {% for value in color_option.values limit: 5 %}
                        {% assign color_handle = value | handle %}
                        {% case color_handle %}
                          {% when 'black' %}
                            {% assign swatch_color = '#000000' %}
                          {% when 'white' %}
                            {% assign swatch_color = '#ffffff' %}
                          {% when 'red' %}
                            {% assign swatch_color = '#dc2626' %}
                          {% when 'blue' %}
                            {% assign swatch_color = '#2563eb' %}
                          {% when 'green' %}
                            {% assign swatch_color = '#16a34a' %}
                          {% when 'yellow' %}
                            {% assign swatch_color = '#eab308' %}
                          {% when 'pink' %}
                            {% assign swatch_color = '#ec4899' %}
                          {% when 'purple' %}
                            {% assign swatch_color = '#9333ea' %}
                          {% when 'orange' %}
                            {% assign swatch_color = '#ea580c' %}
                          {% when 'brown' %}
                            {% assign swatch_color = '#a16207' %}
                          {% when 'gray' or 'grey' %}
                            {% assign swatch_color = '#6b7280' %}
                          {% when 'navy' %}
                            {% assign swatch_color = '#1e3a8a' %}
                          {% else %}
                            {% assign swatch_color = '#9ca3af' %}
                        {% endcase %}
                        <div
                          class="ai-color-swatch-{{ ai_gen_id }}"
                          style="background-color: {{ swatch_color }};"
                          title="{{ value }}"
                          role="button"
                          tabindex="0"
                          aria-label="Select {{ value }} color"
                        ></div>
                      {% endfor %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
            {% assign products_added = products_added | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endunless %}
    {% endfor %}

    {% if block.settings.collection == blank or block.settings.collection.products.size == 0 %}
      {% unless story_cards_added > 0 %}
        <div class="ai-empty-state-{{ ai_gen_id }}">
          <h3>No products to display</h3>
          <p>Select a collection to show products in this grid.</p>
        </div>
      {% endunless %}
    {% endif %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        const sortSelect = this.querySelector('.ai-product-grid-select-{{ ai_gen_id }}');
        const colorSwatches = this.querySelectorAll('.ai-color-swatch-{{ ai_gen_id }}');

        if (sortSelect) {
          sortSelect.addEventListener('change', (e) => {
            this.handleSort(e.target.value);
          });
        }

        colorSwatches.forEach(swatch => {
          swatch.addEventListener('click', (e) => {
            this.handleColorSelection(e.target);
          });

          swatch.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.handleColorSelection(e.target);
            }
          });
        });
      }

      handleSort(sortValue) {
        console.log('Sort selected:', sortValue);
      }

      handleColorSelection(swatch) {
        const productCard = swatch.closest('.ai-product-card-{{ ai_gen_id }}');
        const swatches = productCard.querySelectorAll('.ai-color-swatch-{{ ai_gen_id }}');
        
        swatches.forEach(s => s.style.transform = 'scale(1)');
        swatch.style.transform = 'scale(1.2)';
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "center_content",
      "label": "Center content",
      "default": true
    },
