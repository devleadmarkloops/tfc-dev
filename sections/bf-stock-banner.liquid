      "content": "Update line"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Update label",
      "default": "UPDATE:"
    },
    {
      "type": "range",
      "id": "update_font_size",
      "label": "Update font size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
