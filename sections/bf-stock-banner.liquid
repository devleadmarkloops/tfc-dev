    },
    {
      "type": "range",
      "id": "update_font_size_mobile",
      "label": "Update font size mobile (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "update_weight",
      "label": "Update font weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "range",
      "id": "update_label_weight",
      "label": "Update label weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 600
    },
    {
      "type": "range",
      "id": "update_letter_spacing",
      "label": "Letter spacing (×0.01em)",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4
    },

    {
      "type": "header",
      "content": "Subtext line"
    },
    {
      "type": "text",
      "id": "stock_prefix",
      "label": "Text before number",
