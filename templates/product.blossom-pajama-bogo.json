ton_width":false,"mobile_show_price_in_button":false,"mobile_transparent_bg":false}},"icon_with_text_Vn6pTD":{"type":"icon_with_text","settings":{"layout":"horizontal","icon_color":"accent-1","desktop_icon_size":48,"desktop_spacing":12,"desktop_text_size":18,"mobile_icon_size":40,"mobile_spacing":10,"mobile_text_size":14,"icon_1":"local_shipping","icon_1_fill":false,"heading_1":"Fast + Tracked Shipping","icon_2":"undo","icon_2_fill":false,"heading_2":"30 Days Money Back","icon_3":"Select_Check_Box","icon_3_fill":false,"heading_3":"100% Muslin Cotton","margin_top":24,"margin_bottom":24}},"description":{"type":"description","disabled":true,"settings":{"margin_top":24,"margin_bottom":24}},"reviews_8UgFbe":{"type":"reviews","disabled":true,"settings":{"color_scheme":"background-1","show_custom_bg":false,"custom_bg_color":"#f2f2f2","corner_radius":12,"border_width":0,"border_color":"#b7b7b7","avatar_alignment":"top","avatar_corner_radius":40,"star_color":"#ffcc00","stars_translate":0,"checkmark_color":"#6d388b","checkmark_icon_color":"#ffffff","slider_type":"slide","autoplay":false,"autoplay_speed":5,"display_arrows":false,"display_dots":true,"author_1":"<em>Author<\/em> [stars]","text_1":"<p>Share positive thoughts and feedback from your customer.<\/p>","author_2":"<em>Author<\/em> [stars]","text_2":"<p>Share positive thoughts and feedback from your customer.<\/p>","author_3":"<em>Author<\/em> [stars]","text_3":"<p>Share positive thoughts and feedback from your customer.<\/p>","margin_top":24,"margin_bottom":24}},"custom_liquid_yTefLC":{"type":"custom_liquid","settings":{"custom_liquid":"<div class=\"special-msg\"><b>UPDATE: We're currently going viral on social media <\/b> and have limited stock remaining! Take advantage of our quantity Discounts.<\/div>"}},"de158e68-5d0d-4819-a625-e2dabdff87d1":{"type":"collapsible_tab","settings":{"heading":"What is Muslin Cotton?","heading_size":"medium","icon":"check_box","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<h4><strong>A Fabric Fit for Royalty<\/strong><\/h4><p>Originating from ancient Bengal (modern-day Bangladesh and India), muslin was once so rare and coveted that it was called <em>\"woven wind\"<\/em>—worn by queens, emperors, and aristocrats who prized its <strong>weightless luxury<\/strong>. The finest muslin was so sheer it could pass through a ring yet so strong it lasted generations. Today, authentic muslin remains a symbol of <strong>timeless elegance and craftsmanship<\/strong>.<\/p><h4><strong>Why Is Muslin Cotton Special?<\/strong><\/h4><ul><li><strong>Breathable & Lightweight<\/strong>: Its loose, open weave allows airflow like no other fabric, making it <strong>perfect for temperature regulation<\/strong>—cool in summer, cozy in winter.<\/li><li><strong>Luxuriously Soft<\/strong>: With every wash, muslin becomes even softer, developing a <strong>vintage, lived-in elegance<\/strong> that only improves with time.<\/li><li><strong>Gentle Yet Durable<\/strong>: Despite its delicate feel, high-quality muslin is surprisingly strong, resisting pulls and tears while maintaining its graceful drape.<\/li><\/ul><h4><strong>The Ultimate in Elevated Comfort<\/strong><\/h4><p>Our muslin pyjamas carry forward this legacy, offering you <strong>a touch of historical opulence with modern comfort<\/strong>.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_7GjBCi":{"type":"collapsible_tab","settings":{"heading":"Care","heading_size":"medium","icon":"check_box","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p>Machine wash cold, tumble dry on low heat, and avoid ironing or using fabric softeners to maintain the softness and coziness of your clothes for years to come.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_q8L4T9":{"type":"collapsible_tab","settings":{"heading":"Shipping & Returns","heading_size":"medium","icon":"check_box","filled_icon":false,"