{% doc %}
  @prompt
    Description: A 2 column on mobile and 4 column on desktop product grid section  Each product card displays:
    * A “BEST SELLER” label at the top left of 2 products ( The best selling products)
    * A product image 
    * The product name underneath 
    * Under the product name, the price with a strikethrough original price and next to it ( to its right) a highlighted discounted price (e.g., “From $39”).
    * A horizontal color swatch selector beneath the price, showing the options.
    The top of the section features two dropdowns:
    * Filters (left)
    * Sort: Featured (right), the product cards need to have a padding to the end of the page, they should not take the full width of the page. remove the filter thing and only add the sort: remove the price background color and just leave it black. . let me choose the size of all the texts and wetehr it starts from the middle or not, put the "sort by" box on the left top instead of right and make it smaller. the title of teh product should be centered. make the distance between the products smaller vertically, make less distance between the producut cards vertically, reduce the padding between teh ned of the card and the price. add a shadow control  between the product cards, add the option to add cards that do not contain products, just card wher ei can upload a picture and have a text overlay telling the story of our brand. i want to choose in which column, row and place that certain block is., the position of the story card needs to be able to be different on mobile or desktop. also the image i upload inn the story card doesn't take teh entire card so now there's a big white block. make the image of the story card take the entire card.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    padding: 40px {{ block.settings.section_padding }}px;
    max-width: 1200px;
    {% if block.settings.center_content %}
      margin: 0 auto;
    {% else %}
      margin: 0;
    {% endif %}
  }

  .ai-product-grid-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 30px;
  }

  .ai-product-grid-dropdown-{{ ai_gen_id }} {
    position: relative;
    min-width: 150px;
  }

  .ai-product-grid-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid {{ block.settings.dropdown_border_color }};
    border-radius: {{ block.settings.dropdown_border_radius }}px;
    background-color: {{ block.settings.dropdown_bg_color }};
    color: {{ block.settings.dropdown_text_color }};
    font-size: {{ block.settings.dropdown_text_size }}px;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 8px center;
    background-repeat: no-repeat;
    background-size: 14px;
    padding-right: 30px;
  }

  .ai-product-grid-select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.dropdown_focus_color }};outline-offset: 2px;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.vertical_spacing }}px 20px;
  }

  @media screen and (min-width: 768px) {
    .ai-product-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: {{ block.settings.vertical_spacing }}px 24px;
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% if block.settings.card_shadow_opacity > 0 %}
      box-shadow: 
        {{ block.settings.card_shadow_horizontal }}px 
        {{ block.settings.card_shadow_vertical }}px 
        {{ block.settings.card_shadow_blur }}px 
        rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    {% if block.settings.card_shadow_opacity > 0 %}
      box-shadow: 
        {{ block.settings.card_shadow_horizontal }}px 
        {{ block.settings.card_shadow_vertical | plus: 4 }}px 
        {{ block.settings.card_shadow_blur | plus: 10 }}px 
        rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.5 }});
    {% else %}
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    {% endif %}
  }

  .ai-story-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% if block.settings.card_shadow_opacity > 0 %}
      box-shadow: 
        {{ block.settings.card_shadow_horizontal }}px 
        {{ block.settings.card_shadow_vertical }}px 
        {{ block.settings.card_shadow_blur }}px 
        rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-story-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    {% if block.settings.card_shadow_opacity > 0 %}
      box-shadow: 
        {{ block.settings.card_shadow_horizontal }}px 
        {{ block.settings.card_shadow_vertical | plus: 4 }}px 
        {{ block.settings.card_shadow_blur | plus: 10 }}px 
        rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.5 }});
    {% else %}
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    {% endif %}
  }

  .ai-story-card-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: 1;
  }

  .ai-story-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-story-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-story-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-story-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.story_overlay_opacity | divided_by: 100.0 }}) 100%
    );
    display: flex;
    align-items: {{ block.settings.story_text_vertical_position }};
    justify-content: {{ block.settings.story_text_horizontal_position }};
    padding: 20px;
    z-index: 2;
  }

  .ai-story-card-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.story_text_alignment }};
    color: {{ block.settings.story_text_color }};
    max-width: 100%;
  }

  .ai-story-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.story_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-story-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.story_text_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  .ai-product-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-best-seller-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 8px;
    border-radius: 4px;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_content_padding }}px;
    text-align: center;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 500;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-align: center;
  }

  .ai-product-price-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-product-price-original-{{ ai_gen_id }} {
    font-size: {{ block.settings.original_price_size }}px;
    color: {{ block.settings.original_price_color }};
    text-decoration: line-through;}

  .ai-product-price-sale-{{ ai_gen_id }} {
    font-size: {{ block.settings.sale_price_size }}px;
    font-weight: 600;
    color: #000000;
  }

  .ai-color-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-color-swatch-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .ai-color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-empty-state-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 8px 0;
    font-size: 18px;
    color: #333;
  }

