on_3":"check_circle","filled_icon_3":false,"width":"100%","direction":"vertical","column_gap":0,"enable_bg":false,"bg_color":"#f3f3f3","corner_radius":0,"padding":1,"border_size":0,"border_color":"#b7b7b7"}}},"block_order":["heading_r9KehE","text_3qHH8a","button_PEVLML","text_with_icon_hiiCKV","text_with_icon_afBTmK"],"settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/THE_FLEECE_BLANKET_3.png","height":"adapt","content_layout":"no-overlap","color_scheme":"background-1","section_color_scheme":"background-1","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"reverse","mobile_image_quanlity":"2","mobile_content_alignment":"center","padding_top":24,"padding_bottom":24,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"collapsible_content_AXdPYC":{"type":"collapsible-content","blocks":{"collapsible_row_pm9rhw":{"type":"collapsible_row","settings":{"heading":"What makes them so comfortable?","icon":"check_box","filled_icon":false,"row_content":"<p>Our milk velvet sheets offer supreme comfort due to their ultra-soft texture and luxurious feel. The fabric is specially woven to be gentle on the skin, providing a soothing touch that enhances relaxation and sleep. Additionally, the material has a plush, velvety finish that not only feels exquisite but also conforms to your body, offering support and reducing pressure points. The lightweight nature of the fabric also ensures that it drapes beautifully without feeling heavy, allowing for an unencumbered, cozy sleep experience. All of these features combine to create a sleep environment that is both indulgent and comforting.<\/p>","page":""}},"collapsible_row_tnnYY9":{"type":"collapsible_row","settings":{"heading":"How will these keep me cool?","icon":"check_box","filled_icon":false,"row_content":"<p>Our milk velvet sheets are designed with cooling in mind. They are made from a special fabric blend that is inherently breathable, allowing air to circulate freely. This helps to regulate your body temperature throughout the night by dissipating heat and wicking away moisture. Additionally, the material is lightweight and feels cool to the touch, ensuring you remain comfortable and cool, even on warm nights. With these sheets, you can enjoy a restful sleep without the discomfort of overheating.<\/p>","page":""}},"collapsible_row_FnkxDd":{"type":"collapsible_row","settings":{"heading":"What materials are they made from?","icon":"check_box","filled_icon":false,"row_content":"<p>Our luxurious sheets are crafted from an exquisite material known as milk velvet. This innovative fabric combines the natural softness and eco-friendly attributes of milk-derived fibers with the plush, velvety texture that's synonymous with comfort and elegance. Milk velvet offers a unique blend of durability, breathability, and an unbelievably soft touch, making our sheets a premium choice for those seeking unparalleled comfort and sustainable luxury in their sleeping environment.<\/p>","page":""}},"collapsible_row_7rFWkp":{"type":"collapsible_row","settings":{"heading":"How do I wash and care for these?","icon":"check_box","filled_icon":false,"row_content":"<p>Our velvet sheets are machine washable for easy care. We recommend washing in cold water on a gentle cycle and tumble drying on low. Avoid bleach and fabric softeners to maintain the integrity of the fabric and waterproofing features.<\/p>","page":""}}},"block_order":["collapsible_row_pm9rhw","collapsible_row_tnnYY9","collapsible_row_FnkxDd","collapsible_row_7rFWkp"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"FAQS","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#2e2a39"}},"trustpilot_reviews_kGyPbx":{"type":"trustpilot-reviews","blocks":{"column_mpzd3U":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Love my sheets!","text":"<p>Love my sheets! Not too hot or cold, just perfect for every season. Best sheet purchase I've made.<br\/><\/p>","author":"<em><strong>Cheryl D<\/strong><\/em>"}},"column_67jPJ9":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Exactly what I wanted","text":"<p>Exactly what I was looking for. So soft, cozy, and fits perfectly. It’s a must-have for the whole family!<br\/><\/p>","author":"<em><strong>Daniela S<\/strong><\/em>"}},"column_nfBnNr":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"WAY better than expected","text":"<p>I've wanted these sheets ever since I tried them at a friend’s house, and now I’m hooked. I’m 6’2” and they fit the bed perfectly. Comfort for days!<br\/><\/p>","author":"<em><strong>Derek H<\/strong><\/em>"}},"column_K9Rcka":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Velvet Sheets","text":"<p>Wonderful! Love the color and how soft they feel.<br\/><\/p>","author":"<em><strong>Alyssa S<\/strong><\/em>"}},"column_38r9Qg":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"I LOVE IT!!","text":"<p>Love these sheets. I bought one set for myself and had to get another for my husband because I love mine too much to share! It’s soft, cozy, and fits perfectly. Definitely recommending these sheets to friends and family.<\/p>","author":"<em><strong>Karla F.<\/strong><\/em>"}},"column_hmgeLr":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"10\/10!!","text":"<p>These sheets are amazing! I’ve bought 3 sets, and I don’t think I’ll ever be able to go back to any other kind. They keep me cool at night and are so soft. They fit perfectly, and I love how luxurious they feel!<\/p>","author":"<em><strong>Ramon<\/strong><\/em>"}},"column_yJ3qyE":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Awesome","text":"<p>Can't live without these sheets! They’re a game-changer for my sleep.<br\/><\/p>","author":"<em><strong>Ricky<\/strong><\/em>"}},"column_er7rUH":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Best Sheets Ever","text":"<p>These sheets are so soft! They’re cozy, and they don’t make me feel too hot.<br\/><\/p>","author":"<em><strong>April J<\/strong><\/em>"}},"column_DjgVLg":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Large and Cozy","text":"<p>Amazing quality, and the fit is perfect. These sheets are soft, durable, and so well-made.<\/p>","author":"<em><strong>Colt G<\/strong><\/em>"}},"column_kY8BXf":{"type":"column","settings":{"star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"title":"Best fuzzy ever","text":"<p>These sheets are the absolute best! So soft and comfortable.<br\/><\/p>","author":"<em><strong>Jessie P<\/strong><\/em>"}}},"block_order":["column_mpzd3U","column_67jPJ9","column_nfBnNr","column_K9Rcka","column_38r9Qg","column_hmgeLr","column_yJ3qyE","column_er7rUH","column_DjgVLg","column_kY8BXf"],"settings":{"display_id":false,"visibility":"always-display","color_scheme":"background-1","desktop_content_position":"above","desktop_content_alignment":"center","title":"Our customers speaking","title_highlight_color":"#6d388b","heading_size":"h1","subtitle":"Excellent [rating] <strong>\/ 5<\/strong> [rating_stars]","subheading_rating_text":"<strong>4.8<\/strong>","subheading_mobile_text_size":18,"subheading_desktop_text_size":20,"subheading_font":"body","star_color":"#00b67a","bg_star_color":"#c8c8c8","star_symbol_color":"#ffffff","stars_rating":5,"text":"","cards_border_radius":16,"card_alignment":"center","show_stars":true,"cards_color_scheme":"background-2","type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":24,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":true,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":true,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}}},"order":["main","rich_text_NdcJpj","horizontal_ticker_rHfFDn","related-products","content_tabs_PQjpxj","rich_text_xhmLRt","horizontal_ticker_Xg4Ccz","i