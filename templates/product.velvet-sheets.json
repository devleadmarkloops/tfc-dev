dient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"comparison_table_b3gTWA":{"type":"comparison-table","blocks":{"row_NmY7LN":{"type":"row","settings":{"benefit":"Luxurious Feel","us":true,"others":false}},"row_EaHGgY":{"type":"row","settings":{"benefit":"Enhanced Softness","us":true,"others":false}},"row_ckNngj":{"type":"row","settings":{"benefit":"Cozy & Warm","us":true,"others":false}},"row_PGqM6f":{"type":"row","settings":{"benefit":"Better for Sensitive Skin","us":true,"others":false}},"row_9Hdxif":{"type":"row","settings":{"benefit":"Easy to Wash & Maintain","us":true,"others":false}}},"block_order":["row_NmY7LN","row_EaHGgY","row_ckNngj","row_PGqM6f","row_9Hdxif"],"settings":{"display_id":false,"visibility":"always-display","title":"Why Milk Velvet?","title_highlight_color":"#6d388b","heading_size":"h1","text":"<p>Discover the unparalleled comfort of Milk Velvet fabric. From luxurious softness to better care for sensitive skin, it outperforms cotton in every way. Experience bedding that's cozy, easy to maintain, and designed to elevate your sleep.<\/p>","button_label":"","link":"","button_style_secondary":false,"atc_button_label":"Get Yours Now!","atc_product":"luxury-milk-velvet-sheets","atc_skip_cart":false,"color_scheme":"custom","layout":"table_second","style":"classic","us_label":"Milk Velvet","us_label_size":18,"logo_width":90,"mobile_logo_width":60,"others_label":"Cotton","others_label_size":18,"others_logo_width":90,"others_mobile_logo_width":60,"checkmark_style":"regular","checkmark_color":"#decfbd","checkmark_bg_color":"#53af01","x_style":"regular","x_color":"#121212","x_bg_color":"#dbdbdb","opposite_icon_colors":"original","highlighted_color_scheme":"custom","highlighted_separator_opacity":0,"highlighted_overlay_opacity":0,"other_cells_color_scheme":"background-1","regular_separator_opacity":10,"regular_overlay_opacity":0,"minimalistic_border_opacity":16,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#decfbd","custom_colors_solid_button_text":"#121212","custom_colors_outline_button":"#dd1d1d","custom_colors_highlighted_background":"#decfbd","custom_colors_highlighted_text":"#121212","custom_colors_others_background":"#decfbd","custom_colors_others_text":"#2e2a39"}},"custom_columns_WHURiJ":{"type":"custom-columns","blocks":{"heading_CcQWpd":{"type":"heading","settings":{"column":"col_1","visibility":"always-display","heading":"<strong>What Is Milk Velvet & How Will It Benefit Me?<\/strong>","title_highlight_color":"#121212","heading_size":"h1","alignment":"center","mobile_alignment":"mobile-center","margin_top":20,"margin_bottom":20}},"icon_with_text_x4VNAH":{"type":"icon_with_text","settings":{"column":"col_2","visibility":"always-display","icon":"psychiatry","filled_icon":false,"icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Unique Fabrication","text":"<p>Milk velvet is made by extracting protein from milk, turning it into a powder, and then spinning this powder into a yarn. The blended yarns are woven into a plush fabric, giving milk velvet its characteristic softness and luxurious feel.<\/p>","margin_top":20,"margin_bottom":30}},"icon_with_text_qD9Epc":{"type":"icon_with_text","settings":{"column":"col_2","visibility":"always-display","icon":"wind power","filled_icon":false,"icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Exceptional Breathability","text":"<p>Milk velvet fabric is highly breathable, allowing air to flow freely through the material. This prevents heat accumulation and helps maintain a cool, comfortable temperature throughout the night.<\/p>","margin_top":20,"margin_bottom":20}},"image_DA4cfw":{"type":"image","settings":{"column":"col_3","visibility":"always-display","image":"shopify:\/\/shop_images\/11_2e6d76e5-892f-4321-9b54-505807f7e4dd.png","width":100,"alignment":"center","mobile_alignment":"center","border_radius":0,"margin_top":20,"margin_bottom":20}},"icon_with_text_3wLyX6":{"type":"icon_with_text","settings":{"column":"col_4","visibility":"always-display","icon":"humidity_low","filled_icon":false,"icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Moisture Management","text":"<p>One of the standout features of milk velvet is its ability to effectively wick away moisture. This means it draws sweat away from the body, helping you stay dry and cool even on hot nights.<\/p>","margin_top":20,"margin_bottom":30}},"icon_with_text_Pe8ETc":{"type":"icon_with_text","settings":{"column":"col_4","visibility":"always-display","icon":"cloud","filled_icon":false,"icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Soft and Soothing","text":"<p>Milk velvet sheets offer a superior level of softness compared to traditional cotton. This makes them exceptionally comfortable and a popular choice for a good night's sleep.<\/p>","margin_top":20,"margin_bottom":20}}},"block_order":["heading_CcQWpd","icon_with_text_x4VNAH","icon_with_text_qD9Epc","image_DA4cfw","icon_with_text_3wLyX6","icon_with_text_Pe8ETc"],"settings":{"display_id":false,"visibility":"always-display","color_scheme":"background-1","columns_count":4,"column_gap_desktop":40,"row_gap_desktop":40,"desktop_vertical_alignment":"center","column_gap_mobile":20,"row_gap_mobile":30,"mobile_vertical_alignment":"flex-start","col_1_desktop_width":12,"col_1_mobile_width":4,"col_1_visibility":"always-display","col_2_desktop_width":4,"c